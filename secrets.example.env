# Keystone local secrets — public contract.
# ===========================================================================
# Per CLAUDE.md Section 6, real values for these variables MUST NEVER be
# committed to git. They live in exactly two places:
#
#   1. ~/.keystone/secrets.env  (local, for Terraform / az CLI on your laptop)
#   2. GitHub Actions secrets   (CI, scoped to a GitHub Environment)
#
# To set up a fresh laptop:
#
#   mkdir -p ~/.keystone && chmod 700 ~/.keystone
#   cp secrets.example.env ~/.keystone/secrets.env
#   chmod 600 ~/.keystone/secrets.env
#   # Fill in real values per docs/secrets-inventory.md
#   source ~/.keystone/secrets.env
#
# Source ~/.keystone/secrets.env before any `terraform` or `az` command.
# ===========================================================================

# Azure tenant ID. Retrieve with:
#   az account show --query tenantId -o tsv
export KEYSTONE_TENANT_ID="<paste-tenant-id>"

# MCA billing account ID. Retrieve with:
#   az billing account list --query "[].{Name:displayName, ID:name}" -o table
export KEYSTONE_MCA_BILLING_ACCOUNT_ID="<paste-billing-account-id>"

# MCA billing profile ID (full ARM path). Retrieve with:
#   az billing profile list \
#     --account-name "$KEYSTONE_MCA_BILLING_ACCOUNT_ID" \
#     --query "[].{Name:displayName, ID:id}" -o table
export KEYSTONE_MCA_BILLING_PROFILE_ID="<paste-billing-profile-id>"

# MCA invoice section ID (full ARM path). This is the billing_scope_id
# Terraform passes to azurerm_subscription. Retrieve with:
#   az rest --method get \
#     --url "https://management.azure.com${KEYSTONE_MCA_BILLING_PROFILE_ID}/invoiceSections?api-version=2020-05-01" \
#     --query "value[].{Name:properties.displayName, ID:id}" -o table
export KEYSTONE_MCA_BILLING_SCOPE_ID="<paste-invoice-section-id>"

# Any subscription you already have access to in this tenant. Used by
# platform/05-subscriptions purely as the azurerm provider's auth
# context — subscription vending operates at MCA billing scope, not
# at this sub. Pick one of your existing pre-Keystone subs. Retrieve with:
#   az account list --query "[?state=='Enabled'].{Name:name, ID:id}" -o table
export KEYSTONE_VENDING_CONTEXT_SUBSCRIPTION_ID="<paste-any-existing-sub-id>"

# Subscription ID of keystone-platform-management. Populated AFTER
# platform/05-subscriptions vends the Management sub. Until then, this
# variable is empty and platform/00-bootstrap cannot be applied.
# Retrieve from the 05-subscriptions Terraform output:
#   cd platform/05-subscriptions
#   terraform output -raw mgmt_subscription_id
export KEYSTONE_PLATFORM_MANAGEMENT_SUBSCRIPTION_ID="<populated-after-05-subscriptions-apply>"

# Name of the Terraform state storage account in keystone-platform-management.
# Populated AFTER platform/00-bootstrap creates the SA. Not strictly a
# secret (SA names do not grant access on their own) but kept out of the
# repo to avoid identifying the tenant.
# Retrieve once 00-bootstrap is applied:
#   az storage account list \
#     -g rg-tfstate-plat-weu-001 \
#     --subscription "$KEYSTONE_PLATFORM_MANAGEMENT_SUBSCRIPTION_ID" \
#     --query "[0].name" -o tsv
export KEYSTONE_STATE_STORAGE_ACCOUNT_NAME="<populated-after-00-bootstrap-apply>"

# Email address that receives Azure Cost Management budget threshold
# alerts (10/20/50/80/100% of monthly per-sub spend). Section 6 lists
# email addresses as sensitive — kept out of the repo for that reason.
export KEYSTONE_BUDGET_ALERT_EMAIL="<paste-your-email>"

# Subscription ID of keystone-platform-connectivity. Populated AFTER
# Phase 2 of platform/05-subscriptions vends the sub (blocked on the
# MCA quota ticket). Required by platform/30-connectivity.
# Retrieve from the 05-subscriptions Terraform output:
#   cd platform/05-subscriptions
#   terraform output -raw subscription_ids | jq -r '."platform-connectivity"'
export KEYSTONE_PLATFORM_CONNECTIVITY_SUBSCRIPTION_ID="<populated-after-phase-2-apply>"

# Subscription ID of the pre-existing `lab-foundation` MCA sub, adopted
# into keystone-landing-zones-corp per ADR-0012 (forthcoming) as the
# brownfield workaround for the MCA quota that blocked dedicated
# workload sub vending. Retrieve with:
#   az account show -s lab-foundation --query id -o tsv
export KEYSTONE_LAB_FOUNDATION_SUBSCRIPTION_ID="<paste-lab-foundation-sub-id>"
